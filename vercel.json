{
  "functions": {
    "api/assistant.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/fides-config.js",
      "destination": "/api/inject-config"
    },
    {
      "source": "/teste",
      "destination": "/Fides-app.html"
    },
    {
      "source": "/teste/(.*)",
      "destination": "/Fides-app.html"
    },
    {
      "source": "/painel",
      "destination": "/painel.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/fides-config.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/painel",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
