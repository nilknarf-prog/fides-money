{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/security-reminder.js",
            "statusMessage": "Checando paths sensíveis (api/, supabase/)"
          }
        ]
      }
    ]
  }
}
